# data.go.kr 일반 인증키 (Decoding 값 — URL 인코딩 전 원본)
#
# 공공데이터포털의 일반 인증키는 계정당 하나이고, 승인된 모든 API에 공통으로 쓰인다.
# 따라서 아래 키 하나만 채우면 BIS·TAGO 양쪽 다 동작한다.
#
# 주의: Encoding 키가 아니라 Decoding 키를 넣는다.
#       클라이언트가 URLSearchParams로 인코딩하므로 Encoding 키를 넣으면
#       이중 인코딩이 되어 인증에 실패한다.
DATA_GO_KR_KEY=

# 활용신청이 필요한 API (모두 자동승인)
#  1. 울산광역시 BIS 정보      https://www.data.go.kr/data/15052669/openapi.do   (1,000회/일)
#  2. (TAGO) 버스정류소정보     https://www.data.go.kr/data/15098534/openapi.do  (10,000회/일)
#  3. (TAGO) 버스도착정보       https://www.data.go.kr/data/15098530/openapi.do  (10,000회/일)
#  4. 울산광역시 교통정보       https://www.data.go.kr/data/3057770/openapi.do   (연도별 통계, 3단계용)

# 키를 따로 관리하고 싶을 때만 채운다. 비어 있으면 DATA_GO_KR_KEY를 쓴다.
# ULSAN_BIS_KEY=
# TAGO_KEY=
# ULSAN_TRAFFIC_KEY=

# ── 2단계: 로그 수집 ──────────────────────────────────────────────

# Postgres 연결 문자열. Neon(neon.com) 무료 티어를 쓴다.
# 예: postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# /api/collect 엔드포인트 보호용. 아무 긴 랜덤 문자열이면 된다.
# 생성: openssl rand -hex 32
# GitHub Actions로만 수집한다면 필요 없다(스크립트가 DB에 직접 쓴다).
CRON_SECRET=
